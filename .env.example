# Copy to .env (make up does it for you). Every value here is for the local demo only:
# the stack binds to 127.0.0.1 and holds synthetic data. Never reuse these anywhere real.

# Host ports (loopback only)
POSTGRES_PORT=5433
AIRFLOW_PORT=8080

# Postgres superuser and the three application roles created by demo/postgres/initdb/00_init.sh
POSTGRES_PASSWORD=demo-postgres-superuser
AIRFLOW_DB_PASSWORD=demo-airflow-metadata
ERP_READER_PASSWORD=demo-erp-reader
WAREHOUSE_WRITER_PASSWORD=demo-warehouse-writer

# Signs the Airflow API tokens. Any 32+ character string works.
AIRFLOW_JWT_SECRET=demo-only-jwt-secret-change-me-0123456789

# Linux only: run the Airflow container as your user so it can write demo/data/landing.
# The Makefile sets it from `id -u`; leave it unset on Docker Desktop.
# AIRFLOW_UID=1000
