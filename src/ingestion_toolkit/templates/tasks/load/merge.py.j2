def _conflict_sql(specs: list[tuple[str, str, bool]]) -> str:
    """Upsert on the merge keys. An older version never replaces a newer one."""
    updates = [f"{_quote(n)} = EXCLUDED.{_quote(n)}" for n, _, _ in specs if n not in MERGE_KEYS]
    updates += [
        f"{_quote(n)} = EXCLUDED.{_quote(n)}"
        for n in ("_ingest_run_id", "_ingest_loaded_at", "_ingest_deleted")
    ]
    return (
        f" ON CONFLICT {CONFLICT_TARGET_SQL} DO UPDATE SET {', '.join(updates)}"
        f" WHERE {MERGE_GUARD_SQL}"
    )


def _extra_values(row: dict) -> tuple:
    """The delete flag: set when the operation column holds one of the delete values."""
    if OPERATION_COLUMN is None or row.get(OPERATION_COLUMN) is None:
        return (False,)
    return (str(row[OPERATION_COLUMN]) in DELETE_VALUES,)


